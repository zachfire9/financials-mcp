# Build output (cargo build / cargo test)
/target/

# Local config and secrets
.env
.env.*
!.env.example

# Real plans and financial data stay local. Committed fixtures live in
# tests/fixtures/ and are made up.
/data/
*.local.json
financials-plan-*.json
financials-backup-*.json

# Editor/OS noise
.DS_Store
.vscode/
.idea/

# Settings for `cargo lambda watch` (holds MCP_BEARER_TOKEN).
lambda.env

# SAM: local build output, saved deploy settings (can hold parameter values),
# and filled-in IAM policies (hold the account id).
.aws-sam/
samconfig.toml
/*.filled.json
