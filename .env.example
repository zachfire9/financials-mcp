# Copy to .env for local settings. .env is gitignored; never commit real tokens.
# Values set in the process environment override this file.

# Base URL of financials-api. http:// is only allowed for localhost.
FINANCIALS_API_URL=http://localhost:8080

# Only needed if your financials-api requires an access token.
# FINANCIALS_ACCESS_TOKEN=your-access-token-here

# For `serve --http` only: the secret every request must send as
# "Authorization: Bearer <token>". Required, at least 32 characters.
# Generate one with `openssl rand -base64 32`.
# MCP_BEARER_TOKEN=generate-a-random-token-of-at-least-32-characters

# For `serve --http` only: hostnames accepted in the Host header,
# comma-separated. Leave unset for loopback only (localhost, 127.0.0.1, ::1).
# MCP_ALLOWED_HOSTS=<api-domain>
