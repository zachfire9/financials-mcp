# Copy to .env for local settings. .env is gitignored; never commit real tokens.
# Values set in the process environment override this file.

# Base URL of financials-api. http:// is only allowed for localhost.
FINANCIALS_API_URL=http://localhost:8080

# Only needed if your financials-api requires an access token.
# FINANCIALS_ACCESS_TOKEN=your-access-token-here
